#!/usr/bin/env bash
if [[ ! -t 0 ]]; then cat >/dev/null; fi
counter_file="/Users/shurafa/co-evolution-v13/tests/.sim-pr-emitter-Iq8jGV/counter-A"
n=0
[[ -f "$counter_file" ]] && n=$(cat "$counter_file")
n=$((n+1))
echo "$n" > "$counter_file"
fname=$(printf '%s/%02d.txt' "/Users/shurafa/co-evolution-v13/tests/.sim-pr-emitter-Iq8jGV/stub-queue-A" "$n")
if [[ ! -f "$fname" ]]; then
  # Fallback: replay last queue item (handles tools that invoke claude more times than expected).
  last=$(ls "/Users/shurafa/co-evolution-v13/tests/.sim-pr-emitter-Iq8jGV/stub-queue-A"/??.txt 2>/dev/null | tail -1)
  [[ -f "$last" ]] && cat "$last" || { echo "STUB ERROR: exhausted queue at call $n" >&2; exit 99; }
else
  cat "$fname"
fi
